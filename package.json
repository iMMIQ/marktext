{
  "name": "marktext",
  "version": "0.18.3-beta.3",
  "homepage": "https://github.com/marktext/marktext/",
  "description": "Next generation markdown editor",
  "license": "MIT",
  "main": "./dist/electron/main.js",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "24.x",
    "bun": "1.3.x"
  },
  "scripts": {
    "release": "echo 'Please run \"build\" or \"release:{linux,mac,win}\"' && exit 1",
    "release:linux": "bun run rebuild && bun run pack && bun run package:linux",
    "release:mac": "bun run rebuild && bun run pack && bun run package:mac",
    "release:win": "bun run rebuild && bun run pack && bun run package:win",
    "build": "bun run rebuild && bun run pack && bun run package",
    "build:bin": "bun run rebuild && bun run pack && bun run package:dir",
    "build:clean": "node -e \"const fs=require('fs'); const path=require('path'); const cleanDir=(dir, keep=[])=>{ if (!fs.existsSync(dir)) return; for (const entry of fs.readdirSync(dir)) { if (keep.includes(entry)) continue; fs.rmSync(path.join(dir, entry), { recursive: true, force: true }) } }; cleanDir('build', ['icons']); cleanDir(path.join('dist', 'electron'))\"",
    "build:dev": "bun run pack",
    "benchmark:cold-start": "node tools/perf/cold-start-benchmark.mjs",
    "check": "bun run lint && bun run validate-licenses && bun run unit && bun run test:specs",
    "check:dependency-age": "node tools/release/dependencyAge.mjs",
    "check:release-state": "node tools/release/releaseState.mjs",
    "dev": "bun run tools/dev/bun-dev-runner.mjs",
    "doctor": "bun run tools/dev/doctor.mjs",
    "doctor:release": "bun run tools/dev/doctor.mjs --release",
    "e2e": "bun run pack && node tools/test/runE2E.mjs",
    "e2e:preflight": "node tools/test/runE2E.mjs --desktop-isolation-preflight",
    "e2e:runtime": "node tools/test/runE2E.mjs",
    "format": "eslint --ext .js,.mjs,.vue -f ./node_modules/eslint-friendly-formatter/index.js --fix src test tools *.config.js",
    "format:check": "bun run lint",
    "lint": "eslint --ext .js,.mjs,.vue -f ./node_modules/eslint-friendly-formatter/index.js src test tools *.config.js",
    "lint:fix": "eslint --ext .js,.mjs,.vue -f ./node_modules/eslint-friendly-formatter/index.js --fix src test",
    "pack": "bun run build:clean && bun run pack:runtime && bun run pack:assets",
    "pack:runtime": "bun run tools/build/bun-pack.mjs",
    "pack:assets": "node tools/build/copyStaticAssets.mjs",
    "pack:main": "bun run tools/build/bun-pack.mjs --target=main && bun run tools/build/bun-pack.mjs --target=preload",
    "pack:renderer": "bun run tools/build/bun-pack.mjs --target=renderer",
    "package": "electron-builder --publish never",
    "package:dir": "electron-builder --dir",
    "package:linux": "electron-builder build --linux --publish never",
    "package:mac": "electron-builder build --mac --publish never",
    "package:win": "electron-builder build --win --publish never",
    "test": "bun run unit && bun run test:specs && bun run e2e",
    "test:ci": "bun run check && bun run e2e",
    "test:specs": "node --experimental-specifier-resolution=node test/specs/commonMark/run.spec.mjs && node --experimental-specifier-resolution=node test/specs/gfm/run.spec.mjs",
    "unit": "cross-env NODE_ENV=test vitest run",
    "preinstall": "node tools/install/preflight.js",
    "build:muya": "cd src/muya && webpack --progress --config webpack.config.js",
    "release:muya": "bun run build:muya && cd src/muya && bun publish",
    "release:checksums": "node tools/release/checksums.mjs",
    "rebuild": "node tools/build/rebuildNativeModules.mjs",
    "rebuild:force": "cross-env MARKTEXT_FORCE_NATIVE_REBUILD=1 node tools/build/rebuildNativeModules.mjs",
    "gen-third-party": "node tools/generateThirdPartyLicense.js",
    "validate-licenses": "node tools/validateLicenses.js",
    "verify:native": "node tools/release/nativeBinary.mjs",
    "deobfuscateStackTrace": "node tools/deobfuscateStackTrace.js"
  },
  "dependencies": {
    "@hfelix/electron-localshortcut": "^4.0.1",
    "@octokit/rest": "^22.0.1",
    "@vscode/ripgrep": "^1.17.1",
    "arg": "^5.0.2",
    "ced": "^2.0.0",
    "chokidar": "^5.0.0",
    "command-exists": "^1.2.9",
    "dayjs": "^1.11.20",
    "electron-log": "^5.4.3",
    "electron-store": "^11.0.2",
    "electron-window-state": "^5.0.3",
    "fontmanager-redux": "^1.1.0",
    "fs-extra": "^11.3.4",
    "fuzzaldrin": "^2.1.0",
    "iconv-lite": "^0.7.2",
    "keytar": "^7.9.0",
    "minizlib": "^3.1.0",
    "native-keymap": "^3.3.9",
    "plist": "^4.0.0",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@floating-ui/dom": "^1.7.6",
